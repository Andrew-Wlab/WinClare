# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.spec

# ── PyInstaller ──────────────────────────────────────────
/dist/
/build/
*.spec

# ── Виртуальное окружение ────────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Данные пользователя (не публикуем!) ──────────────────
