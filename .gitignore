# Ничего личного в репозиторий не попадает

# ── Временные файлы ──────────────────────────────────────
*.tmp
*.temp
Thumbs.db
desktop.ini
.DS_Store

# ── Секреты ──────────────────────────────────────────────
*.key
*.pem
secrets.py
config_local.py
